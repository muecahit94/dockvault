{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "release-type": "simple",
    "packages": {
        ".": {
            "package-name": "dockvault",
            "changelog-path": "CHANGELOG.md",
            "extra-files": [
                "VERSION",
                {
                    "type": "json",
                    "path": "frontend/package.json",
                    "jsonpath": "$.version"
                }
            ]
        }
    }
}
