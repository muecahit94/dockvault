# HTTP server port
DOCKVAULT_PORT=8080

# SQLite database directory
DOCKVAULT_DATA_DIR=./data

# Default local backup archive directory
DOCKVAULT_BACKUP_DIR=./backups

# Lightweight container image used to tar/gzip container volumes
DOCKVAULT_HELPER_IMAGE=alpine:3.21

# Optional built-in authentication bootstrap
# DOCKVAULT_AUTH_USERNAME=admin
# DOCKVAULT_AUTH_PASSWORD=change-me-strong-password

# Optional trusted reverse-proxy header (e.g., Remote-User or X-Forwarded-User)
# DOCKVAULT_TRUSTED_PROXY_HEADER=

# Optional global fallback passphrase for AES-256-GCM archive encryption
# DOCKVAULT_ENCRYPTION_KEY=

# Optional space/comma-separated origins allowed to embed DockVault in an iframe
# DOCKVAULT_FRAME_ANCESTORS=

# Timezone for cron schedule evaluation
TZ=UTC
